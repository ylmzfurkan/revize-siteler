---
import { business } from '../data/business';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** href'ler sondaki eğik çizgiyle kurulur (GitHub Pages'te 301 yönlendirmesini önler),
 *  aria-current karşılaştırması normalize edilmiş hâl üzerinden yapılır. */
const path = (p: string) => base + p;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const current = norm(Astro.url.pathname);

const links = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/lezzetler/', label: 'Lezzetler' },
  { href: '/hikayemiz/', label: 'Hikâyemiz' },
  { href: '/galeri/', label: 'Galeri' },
  { href: '/iletisim/', label: 'İletişim' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href={base + '/'}>
      <img src={base + '/images/marka/logo.png'} alt="" width="44" height="44" />
      <span>
        <span class="brand-name">Künefedeyiz</span>
        <span class="brand-sub">Beylikdüzü</span>
      </span>
    </a>

    <nav class="main-nav" id="ana-menu" aria-label="Ana menü">
      {links.map((l) => (
        <a href={path(l.href)} aria-current={norm(path(l.href)) === current ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <a class="button button--gold header-cta" href={business.phoneGsmHref}>Sipariş Ver</a>

    <button class="menu-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="ana-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menüyü aç' : 'Menüyü kapat');
    nav?.classList.toggle('is-open', !open);
  });

  // Menü açıkken masaüstüne geçilirse durumu sıfırla
  window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
    if (e.matches) {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Menüyü aç');
      nav?.classList.remove('is-open');
    }
  });
</script>
