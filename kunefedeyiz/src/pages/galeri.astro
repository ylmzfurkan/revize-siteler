---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, galleryPhotos, videos } from '../data/business';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (p: string) => base + p;
---
<BaseLayout
  title="Galeri — Künefedeyiz Beylikdüzü"
  description="Künefedeyiz mekân fotoğrafları ve Künefedeyiz Beylikdüzü YouTube kanalındaki hazırlık, servis ve lezzet videoları."
  ogImage="/images/mekan/mekan-5.jpg"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">MEDYA</p>
      <h1>Mekânımızdan<br /><em>kareler.</em></h1>
      <p class="lede">
        Ocak başındaki hazırlıktan sofraya gelen son hâline kadar; gerçek servis
        anlarımız.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="photo-grid">
        {galleryPhotos.map((g) => (
          <img src={path(g.src)} alt={g.alt} loading="lazy" width="1000" height="1333" />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">VİDEOLAR</p>
          <h2>Ateşin başında <em>ustalık.</em></h2>
        </div>
        <a class="text-link" href={business.youtube} target="_blank" rel="noopener">YouTube kanalımız →</a>
      </div>
      <div class="video-grid">
        {videos.map((v) => (
          <article class="video-card">
            <div class="video-frame">
              <button type="button" data-video={v.id} aria-label={`${v.title} videosunu oynat`}>
                <img
                  src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                  alt="" loading="lazy" width="480" height="360"
                />
                <span class="video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </button>
            </div>
            <h3>{v.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* Facade: iframe yalnızca tıklanınca yüklenir — 14 video peşin yüklenmesin. */
  document.querySelectorAll<HTMLButtonElement>('.video-frame button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.video;
      if (!id) return;
      const frame = btn.parentElement;
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  });
</script>
