---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, valueProps, galleryPhotos } from '../data/business';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (p: string) => base + p;
const featured = products.slice(0, 6);
const strip = galleryPhotos.slice(1, 5);
---
<BaseLayout
  title="Künefedeyiz — Beylikdüzü’nde Künefe, Katmer, Kadayıf ve Dondurma"
  description="Beylikdüzü Cumhuriyet Mahallesi’nde künefe salonu. Erdal Şayir farkıyla künefe, katmer, kadayıf ve dondurma. Paket servis, ücretsiz otopark ve vale hizmeti."
>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <p class="eyebrow">İSTANBUL · BEYLİKDÜZÜ</p>
        <h1>Gelin bu işi<br /><em>tatlıya bağlayalım.</em></h1>
        <p class="hero-sub">Künefe &amp; Katmer &amp; Kadayıf &amp; Dondurma</p>
        <p class="lede">
          Künefe denince üstün lezzet ve kalite farkıyla siz değerli dostlarımızın
          gönlünde yer tutmaya devam ediyoruz. İstanbul Beylikdüzü’nde{' '}
          <strong>Erdal Şayir</strong> farkıyla sizleri mekânımıza bekliyoruz.
        </p>
        <div class="hero-actions">
          <a class="button button--gold" href={business.phoneGsmHref}>Sipariş Ver</a>
          <a class="button button--ghost" href={path('/lezzetler/')}>Lezzetleri İncele</a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src={path('/images/urunler/sade-kunefe.jpg')}
          alt="Gümüş servis tabağında antep fıstığıyla sunulan sade künefe"
          width="1000" height="666" fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SOFRANIN GÖZDELERİ</p>
          <h2>İmza <em>lezzetlerimiz</em></h2>
        </div>
        <a class="text-link" href={path('/lezzetler/')}>Tüm lezzetleri gör →</a>
      </div>
      <div class="dish-grid">
        {featured.map((p) => (
          <article class="dish">
            <img src={path(p.image)} alt={p.name.toLocaleLowerCase('tr-TR')} loading="lazy" width="1000" height="666" />
            <h3>{p.name}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">NEDEN KÜNEFEDEYİZ</p>
          <h2>Hakikaten kaliteli,<br /><em>hijyenik ve şeffaf.</em></h2>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="value-grid">
        {valueProps.map((v) => (
          <div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MEKÂNIMIZDAN</p>
          <h2>Ocak başından <em>sofranıza.</em></h2>
        </div>
        <a class="text-link" href={path('/galeri/')}>Galeriye git →</a>
      </div>
      <div class="photo-grid">
        {strip.map((g) => (
          <img src={path(g.src)} alt={g.alt} loading="lazy" width="1000" height="1333" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">BEYLİKDÜZÜ’NDE BEKLİYORUZ</p>
        <h2>Bir telefon kadar <em>yakınız.</em></h2>
        <p class="lede">
          {business.addressFull}
        </p>
        <p class="note">
          Paket servis bölgelerimiz: {business.serviceAreas.join(', ')}.
          Sipariş için {business.orderHours} arası arayabilirsiniz.
        </p>
        <div class="hero-actions">
          <a class="button button--gold" href={business.phoneGsmHref}>{business.phoneGsm}</a>
          <a class="button button--ghost" href={business.maps} target="_blank" rel="noopener">Yol Tarifi Al</a>
        </div>
      </div>
      <div>
        <img
          src={path('/images/mekan/mekan-2.jpg')}
          alt="Künefedeyiz’in Beylikdüzü’ndeki dükkân cephesi"
          loading="lazy" width="1000" height="1333"
          style="border-radius: var(--radius);"
        />
      </div>
    </div>
  </section>
</BaseLayout>
