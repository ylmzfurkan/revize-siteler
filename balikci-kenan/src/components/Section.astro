---
interface Props { title: string; id: string; eyebrow?: string; }
const { title, id, eyebrow } = Astro.props;
---
<section class="section container" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-heading">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <slot name="aside" />
  </div>
  <slot />
</section>
