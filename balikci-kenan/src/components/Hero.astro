---
interface Props {
  title: string;
  subtitle?: string | null;
  ctaHref?: string | null;
  address?: string | null;
}
const { title, subtitle, ctaHref, address } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Orijinal Balıkçı Kenan fotoğrafları — hiçbir kırılma noktasında kırpılmadan gösterilir.
const slides = [
  { file: "hero-tezgah.jpg", alt: "Balıkçı Kenan tezgahında kurutulmuş balıklar ve ziyaretçi" },
  { file: "hero-izgara-cocuklar.jpg", alt: "Balıkçı Kenan'da ızgarada pişen balıklar" },
  { file: "hero-teras.jpg", alt: "Balıkçı Kenan'ın ağaç gölgesindeki restoran terası" },
];
---
<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-media">
      {slides.map((slide, index) => (
        <img
          class={`hero-photo slide-${index + 1}`}
          src={`${base}/images/hero-original/${slide.file}`}
          alt={slide.alt}
          width="2514"
          height="956"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 ? "high" : "auto"}
        />
      ))}
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>

    <div class="hero-panel">
      <div class="container hero-content">
        {subtitle && <p class="hero-eyebrow"><span class="rule" aria-hidden="true"></span>{subtitle}</p>}
        <h1 id="hero-title">
          <span class="hero-title-main">{title}</span>
          <span class="hero-title-sub">Bir İstanbul klasiği.</span>
        </h1>
        <p class="hero-description">
          Kadıköy iskelesinde başlayan bir hikâye.<br />Denize duyulan sevgi, sofrada buluşan lezzet.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#products">Lezzetleri keşfet <span aria-hidden="true">↗</span></a>
          {ctaHref && <a class="button button-ghost" href={ctaHref}>Bizi arayın <span aria-hidden="true">↗</span></a>}
        </div>
        {address && <p class="hero-note"><span class="hero-note-icon" aria-hidden="true">⌖</span>{address}</p>}
      </div>
    </div>

    <div class="year-seal" aria-hidden="true">
      <span>İSTANBUL</span>
      <strong>1960</strong>
      <span>HİKÂYENİN BAŞLANGICI</span>
    </div>
  </div>

  <div class="hero-ticker">
    <div class="container hero-ticker-inner">
      <span>Balıkçılık bir tutku meselesi</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>Her gün taze</span>
      <a href="#products">Keşfetmeye devam et <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>
