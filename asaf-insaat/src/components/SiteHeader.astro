---
import BrandMark from "./BrandMark.astro";
import { url } from "../data/urls";
import { nav } from "../data/content";

export interface Props {
  /** Hero'nun üzerine binen şeffaf başlık (ana sayfa gibi tam ekran açılışlar). */
  overlay?: boolean;
  pathname: string;
}

const { overlay = false, pathname } = Astro.props;

const isCurrent = (path: string) => {
  const clean = url(path).replace(/\/$/, "");
  const here = pathname.replace(/\/$/, "");
  return here === clean;
};
---

<header class:list={["site-header", { "site-header--overlay": overlay }]} data-header>
  <div class="site-header__bar">
    <a class="site-header__brand" href={url()} aria-label="ASAF — ana sayfa">
      <BrandMark size="clamp(2.1rem, 4.4vw, 2.9rem)" duration="9s" />
      <span class="site-header__brand-text">
        <span>ASAF</span>
        <small>Otomotiv ve İnşaat</small>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Ana menü">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={url(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost site-header__cta" href={url("iletisim/")}>
        Teklif alın <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">Menüyü aç</span>
        <span class="site-header__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <span class="site-header__hairline" aria-hidden="true"></span>
</header>

<div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
  <nav aria-label="Mobil menü">
    <ul>
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={url(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
            <small>{String(i + 1).padStart(2, "0")}</small>
            <span class="mobile-nav__label">{item.label}</span>
            <em>{item.description}</em>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mobile-nav__foot">
    <a class="btn btn--primary" href={url("iletisim/")}>
      Projenizi konuşalım <span class="btn__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    transition:
      transform var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }

  /* Hero üstünde başlarken cam ve çizgi kaybolur, içerik nefes alır. */
  .site-header--overlay {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--overlay.is-stuck {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  /* Aşağı kaydırırken gizlenir, yukarı kaydırırken geri gelir. */
  .site-header.is-hidden { transform: translateY(-102%); }

  .site-header__hairline {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-gold) 22%, var(--line-gold) 78%, transparent);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .site-header.is-stuck .site-header__hairline,
  .site-header:not(.site-header--overlay) .site-header__hairline { opacity: 1; }

  .site-header__bar {
    width: min(100% - (var(--gutter) * 2), var(--wide));
    margin-inline: auto;
    min-block-size: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.55rem, 1.6vw, 0.9rem);
    flex: none;
  }
  .site-header__brand-text {
    display: none;
    flex-direction: column;
    line-height: 1.1;
  }
  .site-header__brand-text span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.22em;
  }
  .site-header__brand-text small {
    font-size: 0.6rem;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 30rem) {
    .site-header__brand-text { display: flex; }
  }

  .site-header__nav { display: none; }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.1rem);
  }
  .site-header__nav a {
    position: relative;
    display: block;
    padding-block: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--paper-dim);
    transition: color var(--dur) var(--ease-out);
  }
  /* Altın alt çizgi ortadan açılır. */
  .site-header__nav a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--gold-300);
    transform: scaleX(0);
    transform-origin: 50% 50%;
    transition: transform var(--dur) var(--ease-out);
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] { color: var(--gold-200); }
  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current="page"]::after { transform: scaleX(1); }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex: none;
  }
  .site-header__cta { display: none; min-height: 44px; padding-inline: var(--space-s); }

  .site-header__toggle {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color var(--dur) var(--ease-out);
  }
  .site-header__toggle:hover { border-color: var(--line-gold); }

  /* Masaüstünde tam menü görünür, hamburger gizlenir. */
  @media (min-width: 62rem) {
    .site-header__nav { display: block; }
    .site-header__cta { display: inline-flex; }
    .site-header__toggle { display: none; }
  }
  .site-header__burger {
    display: grid;
    gap: 5px;
    inline-size: 18px;
  }
  .site-header__burger i {
    display: block;
    block-size: 1.5px;
    background: var(--paper);
    transition: transform var(--dur) var(--ease-out);
  }
  .site-header__toggle[aria-expanded="true"] .site-header__burger i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded="true"] .site-header__burger i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* --- Mobil menü ------------------------------------------------------- */

  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xl);
    padding: calc(var(--header-h) + var(--space-l)) var(--gutter) var(--space-xl);
    background:
      radial-gradient(120% 80% at 80% 0%, color-mix(in oklab, var(--gold-900) 55%, transparent), transparent 60%),
      color-mix(in oklab, var(--ink-000) 96%, transparent);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-nav[hidden] { display: none; }

  .mobile-nav ul { display: grid; }
  .mobile-nav li { border-block-start: 1px solid var(--line-soft); }
  .mobile-nav li:last-child { border-block-end: 1px solid var(--line-soft); }

  .mobile-nav a {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0 var(--space-s);
    padding-block: clamp(0.75rem, 2.6vw, 1.15rem);
  }
  .mobile-nav a small {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--gold-500);
  }
  .mobile-nav__label {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
  }
  .mobile-nav a em {
    grid-column: 2;
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--step--2);
    color: var(--muted-dim);
    margin-block-start: 0.35em;
  }
  .mobile-nav a[aria-current="page"] .mobile-nav__label { color: var(--gold-300); }

  .mobile-nav__foot .btn { width: 100%; }

  /* Açılışta satırlar sırayla yukarı kayar. */
  .mobile-nav.is-open li {
    animation: nav-in 520ms var(--ease-out) both;
    animation-delay: calc(60ms + (var(--i) * 55ms));
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav.is-open li { animation: none; }
    .site-header, .site-header__nav a::after, .site-header__burger i { transition: none; }
    .site-header.is-hidden { transform: none; }
  }
</style>
