---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import { visuals } from "../data/visuals";
import { business, hasDirectContact } from "../data/business";
import { faq } from "../data/content";

const projectTypes = [
  "Villa / müstakil konut",
  "Betonarme / kaba yapı",
  "Cephe / yalıtım",
  "İnce iş / iç mekân",
  "Tadilat / yenileme",
  "Otomotiv / şarj altyapısı",
  "Diğer",
];

const channels = [
  { key: "Telefon", value: business.contact.phone, href: business.contact.phone ? `tel:${business.contact.phone.replace(/\s/g, "")}` : null },
  { key: "E-posta", value: business.contact.email, href: business.contact.email ? `mailto:${business.contact.email}` : null },
  { key: "Adres", value: business.contact.address, href: null },
  { key: "Çalışma saatleri", value: business.workingHours, href: null },
];

const pageFaq = [faq[0], faq[5], faq[2]];
---

<BaseLayout
  title="İletişim"
  description="ASAF Otomotiv ve İnşaat ile iletişime geçin. Projenizi anlatın, yerinde görüp nasıl ilerleyeceğimizi paylaşalım."
>
  <PageHero
    eyebrow="İletişim"
    title="Projenizi"
    accent="anlatın"
    lead="Aklınızdaki işi birkaç cümleyle aktarın; nasıl ilerleyeceğimizi somut biçimde paylaşalım."
    visual={{
      src: visuals.detail.src,
      small: visuals.detail.small,
      alt: visuals.detail.alt,
      width: visuals.detail.width,
      height: visuals.detail.height,
      isConcept: visuals.detail.isConcept,
    }}
  />

  <section class="section">
    <div class="shell shell--wide contact">
      {/* --- Form ------------------------------------------------------ */}
      <div class="contact__form-wrap" data-reveal>
        <h2 class="contact__title">Proje formu</h2>
        <p class="contact__hint">
          Alanları doldurun; mesajınız aşağıda hazırlanır.
          {business.contact.email
            ? " Gönder düğmesi e-posta uygulamanızı açar."
            : " E-posta adresi siteye eklendiğinde form doğrudan göndermeye başlayacak; şimdilik mesajı kopyalayıp Instagram üzerinden iletebilirsiniz."}
        </p>

        <form
          class="form"
          data-contact-form
          data-email={business.contact.email ?? ""}
          novalidate
        >
          <div class="form__row">
            <label class="field">
              <span class="field__label">Ad Soyad <em>*</em></span>
              <input class="field__input" type="text" name="name" required autocomplete="name" />
            </label>
            <label class="field">
              <span class="field__label">Telefon</span>
              <input class="field__input" type="tel" name="phone" autocomplete="tel" inputmode="tel" />
            </label>
          </div>

          <div class="form__row">
            <label class="field">
              <span class="field__label">E-posta</span>
              <input class="field__input" type="email" name="email" autocomplete="email" inputmode="email" />
            </label>
            <label class="field">
              <span class="field__label">Proje türü</span>
              <span class="field__select">
                <select class="field__input" name="type">
                  <option value="">Seçiniz</option>
                  {projectTypes.map((type) => <option value={type}>{type}</option>)}
                </select>
              </span>
            </label>
          </div>

          <label class="field">
            <span class="field__label">Projeniz <em>*</em></span>
            <textarea
              class="field__input field__input--area"
              name="message"
              rows="6"
              required
              placeholder="Arsanın veya yapının durumu, ihtiyacınız ve zaman beklentiniz."
            ></textarea>
          </label>

          <div class="form__actions">
            <button class="btn btn--primary" type="submit">
              {business.contact.email ? "Mesajı gönder" : "Mesajı hazırla ve kopyala"}
              <span class="btn__arrow" aria-hidden="true">↗</span>
            </button>
            {business.social.instagram && (
              <a
                class="btn btn--ghost"
                href={business.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram'dan yazın <span class="btn__arrow" aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <p class="form__status" role="status" data-form-status></p>
        </form>
      </div>

      {/* --- Kanallar --------------------------------------------------- */}
      <aside class="contact__side">
        <div class="contact__card" data-reveal style="--reveal-delay:100ms">
          <h2 class="contact__card-title">İletişim kanalları</h2>
          <dl class="spec">
            {channels.map((channel) => (
              <div class="spec__row">
                <dt class="spec__key">{channel.key}</dt>
                <dd class="spec__val">
                  {channel.value
                    ? channel.href
                      ? <a href={channel.href}>{channel.value}</a>
                      : channel.value
                    : <em class="contact__pending">bilgi bekleniyor</em>}
                </dd>
              </div>
            ))}
            <div class="spec__row">
              <dt class="spec__key">Instagram</dt>
              <dd class="spec__val">
                {business.social.instagram ? (
                  <a href={business.social.instagram} target="_blank" rel="noopener noreferrer">
                    @asaf.insaat ↗
                  </a>
                ) : (
                  <em class="contact__pending">bilgi bekleniyor</em>
                )}
              </dd>
            </div>
          </dl>
        </div>

        {!hasDirectContact && (
          <p class="pending" data-reveal style="--reveal-delay:160ms">
            <strong>Onay bekleyen bölüm:</strong>
            Telefon, e-posta ve adres bilgileri firmadan henüz alınmadı. Bilgiler
            geldiğinde bu alanlar otomatik olarak dolacak; şu an uydurma
            iletişim bilgisi gösterilmiyor.
          </p>
        )}
      </aside>
    </div>
  </section>

  {/* --- SSS ------------------------------------------------------------- */}
  <section class="section section--tight">
    <div class="shell shell--narrow">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Sık sorulanlar</p>
        <h2 class="section-head__title">Yazmadan önce <span class="foil">merak edilenler</span></h2>
      </header>
      <div data-reveal>
        <Faq items={pageFaq} name="iletisim-faq" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 62rem) {
    .contact { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: var(--space-3xl); }
  }

  .contact__title { font-size: var(--step-3); }
  .contact__hint {
    margin-block: var(--space-xs) var(--space-l);
    color: var(--muted);
    font-size: var(--step--1);
    max-inline-size: 58ch;
  }

  .form { display: grid; gap: var(--space-m); }
  .form__row { display: grid; gap: var(--space-m); }
  @media (min-width: 40rem) { .form__row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .field { display: grid; gap: var(--space-2xs); }
  .field__label {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .field__label em { color: var(--gold-300); font-style: normal; }

  .field__input {
    inline-size: 100%;
    min-block-size: 52px;
    padding: var(--space-xs) var(--space-s);
    font: inherit;
    font-size: var(--step-0);
    color: var(--paper);
    background: color-mix(in oklab, var(--ink-200) 80%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    transition: border-color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }
  .field__input::placeholder { color: var(--muted-dim); }
  .field__input:hover { border-color: color-mix(in oklab, var(--paper) 20%, transparent); }
  .field__input:focus-visible {
    outline: none;
    border-color: var(--gold-300);
    background: color-mix(in oklab, var(--ink-300) 80%, transparent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--gold-300) 18%, transparent);
  }
  .field__input--area { min-block-size: 0; resize: vertical; line-height: 1.6; }
  .field__input:user-invalid { border-color: #C7583F; }

  /* Yerel select okunu gizleyip kendi okumuzu koyuyoruz. */
  .field__select { position: relative; display: block; }
  .field__select select { appearance: none; padding-inline-end: var(--space-xl); }
  .field__select::after {
    content: "";
    position: absolute;
    inset-inline-end: var(--space-s);
    inset-block-start: 50%;
    inline-size: 8px;
    block-size: 8px;
    border-inline-end: 1.5px solid var(--gold-300);
    border-block-end: 1.5px solid var(--gold-300);
    translate: 0 -70%;
    rotate: 45deg;
    pointer-events: none;
  }
  .field__select select option { background: var(--ink-200); color: var(--paper); }

  .form__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-block-start: var(--space-2xs); }

  .form__status {
    min-block-size: 1.5em;
    font-size: var(--step--1);
    color: var(--gold-200);
  }
  .form__status[data-tone="error"] { color: #E08B76; }

  .contact__side { display: grid; gap: var(--space-m); }
  .contact__card {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-l);
    background: color-mix(in oklab, var(--ink-200) 70%, transparent);
  }
  .contact__card-title {
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }
  .contact__card .spec__val a { color: var(--gold-200); }
  .contact__pending { color: var(--gold-500); font-size: 0.9em; }

  @media (prefers-reduced-motion: reduce) {
    .field__input { transition: none; }
  }
</style>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    if (!form || form.dataset.ready === "1") return;
    form.dataset.ready = "1";
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const target = form.dataset.email || "";

    const compose = (data: FormData) => {
      const line = (label: string, key: string) => {
        const value = String(data.get(key) ?? "").trim();
        return value ? `${label}: ${value}` : null;
      };
      return [
        line("Ad Soyad", "name"),
        line("Telefon", "phone"),
        line("E-posta", "email"),
        line("Proje türü", "type"),
        "",
        String(data.get("message") ?? "").trim(),
      ]
        .filter((row) => row !== null)
        .join("\n");
    };

    const say = (text: string, tone: "ok" | "error" = "ok") => {
      if (!status) return;
      status.textContent = text;
      status.dataset.tone = tone;
    };

    const onSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!form.reportValidity()) {
        say("Lütfen zorunlu alanları doldurun.", "error");
        return;
      }

      const data = new FormData(form);
      const body = compose(data);
      const subject = `Proje talebi — ${String(data.get("name") ?? "").trim()}`;

      // E-posta adresi tanımlıysa doğrudan posta uygulaması açılır.
      if (target) {
        window.location.href =
          `mailto:${target}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        say("E-posta uygulamanız açılıyor.");
        return;
      }

      // Adres henüz yoksa mesaj panoya kopyalanır ve elle iletilebilir.
      try {
        await navigator.clipboard.writeText(`${subject}\n\n${body}`);
        say("Mesajınız panoya kopyalandı. Instagram üzerinden gönderebilirsiniz.");
      } catch {
        say("Mesaj kopyalanamadı. Metni seçip elle kopyalayabilirsiniz.", "error");
      }
    };

    form.addEventListener("submit", onSubmit);
    document.addEventListener("astro:before-swap", () => form.removeEventListener("submit", onSubmit), {
      once: true,
    });
  }

  // İlk astro:page-load bu modülden önce gönderildiği için doğrudan çağrılır.
  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
