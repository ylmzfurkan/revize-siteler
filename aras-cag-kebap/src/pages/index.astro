---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuItems } from '../data/business';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>
<section class="hero"><img src={base + "/images/hero.jpg"} alt="Aras Cağ Kebap’ta odun ateşinde pişen cağ kebabı" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="eyebrow">ERZURUM’DAN İSTANBUL’A</p><h1>Ateşin başında<br/><em>ustalıkla.</em></h1><p>Seçilmiş kuzu eti, doğru marinasyon ve odun ateşinde ağır ağır pişen gerçek cağ kebabı.</p><div class="hero-actions"><a class="button gold" href="#lezzetler">Lezzetleri keşfet</a><a class="button ghost" href={business.whatsapp}>Rezervasyon ↗</a></div></div><div class="hero-note"><span>20+</span><p>Yıllık<br/>ustalık</p></div></section>
<section class="manifesto section"><p class="eyebrow dark">GERÇEK LEZZETİN ÜÇ UNSURU</p><h2>Et. Ateş. <em>Ustalık.</em></h2><div class="principles"><article><span>01</span><h3>Seçilmiş et</h3><p>Kuzu but ve sırt etlerinden günlük olarak hazırlanan özel lezzet.</p></article><article><span>02</span><h3>Odun ateşi</h3><p>Geleneksel yöntemle, ateşin karşısında ağır ağır pişirme.</p></article><article><span>03</span><h3>Usta servis</h3><p>Şef Adem Aras’ın 20 yılı aşkın deneyiminden sofranıza.</p></article></div></section>
<section class="featured section" id="lezzetler"><div class="section-heading"><div><p class="eyebrow dark">SOFRANIN GÖZDELERİ</p><h2>İmza <em>lezzetler</em></h2></div><a href={base + "/menu/"}>Tüm menüyü gör ↗</a></div><div class="dish-grid">{menuItems.slice(0,6).map((item,i)=><article class:list={['dish-card',i===0&&'dish-card--wide']}><div class="dish-image"><img src={base + item.image} alt={item.name} loading="lazy"/><span>{item.category}</span></div><div class="dish-copy"><h3>{item.name}</h3><p>{item.description}</p><strong>{item.price}</strong></div></article>)}</div></section>
<section class="story-preview"><div class="story-image"><img src={base + "/images/restaurant.jpg"} alt="Aras Cağ Kebap Beylikdüzü restoranının dış görünümü" loading="lazy"/></div><div class="story-copy"><p class="eyebrow">BİZİM HİKÂYEMİZ</p><h2>Geleneği geleceğe<br/><em>taşıyan sofra.</em></h2><p>Ömer Muhtaroğlu ve Ercüment Aras ortaklığında kurulan Aras Cağ Gastronomi, Şef Adem Aras’ın 20 yılı aşkın ustalığıyla gerçek Erzurum cağ kebabını İstanbul’da yaşatıyor.</p><a class="text-link" href={base + "/hikayemiz/"}>Hikâyemizi okuyun ↗</a></div></section>
<section class="visit section"><div><p class="eyebrow dark">BEYLİKDÜZÜ’NDE BEKLİYORUZ</p><h2>Ateşin sıcaklığı,<br/><em>sofranın samimiyeti.</em></h2></div><div class="visit-info"><p>{business.address}</p><a href={business.maps} target="_blank">Yol tarifi al ↗</a><a href={business.phoneHref}>{business.phone}</a></div></section>
</BaseLayout>
