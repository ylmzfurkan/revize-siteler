---
export interface Props {
  title: string;
  subtitle?: string | null;
  ctaLabel?: string | null;
  ctaHref?: string | null;
  imageSrc?: string | null;
  imageAlt?: string | null;
}
const { title, subtitle, ctaLabel, ctaHref, imageSrc, imageAlt } = Astro.props;
---
<section class="hero">
  <div class="hero__content">
    <h1>{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {ctaLabel && ctaHref && (
      <a class="hero__cta" href={ctaHref}>{ctaLabel}</a>
    )}
  </div>
  {imageSrc && (
    <div class="hero__media">
      <img src={imageSrc} alt={imageAlt ?? ""} loading="eager" />
    </div>
  )}
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3rem 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .hero__subtitle {
    font-size: 1.125rem;
    opacity: 0.85;
    max-width: 60ch;
  }
  .hero__cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    background: var(--color-accent, #3366ff);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .hero__media img {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      align-items: center;
      padding: 4rem 2rem;
    }
    .hero__content,
    .hero__media {
      flex: 1;
    }
  }
</style>
