---
export interface Props {
  title?: string | null;
  id?: string;
}
const { title, id } = Astro.props;
---
<section class="section" id={id}>
  {title && <h2 class="section__title">{title}</h2>}
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 3rem 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section__title {
    margin-bottom: 1.5rem;
  }
</style>
