---
import { business } from '../data/business';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site-header"><a class="brand" href={base + "/"} aria-label="Aras Cağ Kebap ana sayfa"><span class="brand-mark"><img src={base + "/images/logo.jpg"} alt="Aras Cağ Kebap logosu"/></span><span class="brand-name">Aras <em>Cağ Kebap</em></span></a><button class="menu-toggle" aria-label="Menüyü aç" aria-expanded="false"><span></span><span></span></button><nav class="main-nav" aria-label="Ana menü"><a href={base + "/#lezzetler"}>Lezzetler</a><a href={base + "/hikayemiz/"}>Hikâyemiz</a><a href={base + "/menu/"}>Menü</a><a href={base + "/iletisim/"}>İletişim</a></nav><a class="header-cta" href={business.phoneHref}>Rezervasyon ↗</a></header>
<script>const b=document.querySelector('.menu-toggle'),n=document.querySelector('.main-nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('is-open',!o)});</script>
